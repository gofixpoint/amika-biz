#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$( cd -- "$( dirname -- "${BASH_SOURCE[0]:-$0}"; )" &> /dev/null && pwd 2> /dev/null; )";
ROOT_DIR=$(realpath "${SCRIPT_DIR}/..")

cd "$ROOT_DIR"

# Parse --no-op flag (consumed here, not forwarded to the TS CLI)
USE_OP=true
ARGS=()
for arg in "$@"; do
  if [[ "$arg" == "--no-op" ]]; then
    USE_OP=false
  else
    ARGS+=("$arg")
  fi
done

TSX=(npx --prefix "src/ts" tsx "src/ts/cmd/main.ts")

"${TSX[@]}" ${ARGS[@]+"${ARGS[@]}"}
